SERVER_ADDRESS=127.0.0.1
SERVER_PORT=18081
FLOWTRAIL_DB_URL=jdbc:h2:file:./data/flowtrail-runtime-v2;DB_CLOSE_ON_EXIT=FALSE;WRITE_DELAY=0
FLOWTRAIL_DB_USER=sa
FLOWTRAIL_DB_PASSWORD=

# MySQL: set SPRING_PROFILES_ACTIVE=mysql and replace connection settings.
# FLOWTRAIL_DB_URL=jdbc:mysql://127.0.0.1:13306/flowtrail_runtime?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
# FLOWTRAIL_DB_USER=flowtrail
# FLOWTRAIL_DB_PASSWORD=replace-with-a-local-password

# live-default model settings (read from process environment).
# FLOWTRAIL_MODEL_BASE_URL=https://example.invalid
# FLOWTRAIL_MODEL_NAME=your-model-name
# FLOWTRAIL_MODEL_VERSION=deployment-v1
# FLOWTRAIL_MODEL_API_KEY=replace-with-your-key

